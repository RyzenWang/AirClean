<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AirClean.App.ViewModels"
        x:Class="AirClean.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{DynamicResource L.SettingsTitle}"
        Width="760"
        Height="720"
        MinWidth="620"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,24,28,18" Spacing="16">
        <TextBlock Text="{DynamicResource L.SettingsTitle}"
                   FontSize="26"
                   FontWeight="SemiBold"
                   LetterSpacing="-0.5" />

        <Border Classes="card" Padding="18,16" CornerRadius="14">
          <StackPanel Spacing="12">
            <TextBlock Text="{DynamicResource L.SectionAppearance}" Classes="eyebrow" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
              <StackPanel Spacing="5">
                <TextBlock Text="{DynamicResource L.Theme}" Classes="caption" FontSize="11" />
                <ComboBox SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                  <ComboBoxItem Content="{DynamicResource L.ThemeSystem}" />
                  <ComboBoxItem Content="{DynamicResource L.ThemeLight}" />
                  <ComboBoxItem Content="{DynamicResource L.ThemeDark}" />
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="{DynamicResource L.Language}" Classes="caption" FontSize="11" />
                <ComboBox SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                  <ComboBoxItem Content="English" />
                  <ComboBoxItem Content="简体中文" />
                </ComboBox>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="18,16" CornerRadius="14">
          <StackPanel Spacing="14">
            <TextBlock Text="{DynamicResource L.SectionScan}" Classes="eyebrow" />

            <StackPanel Spacing="7">
              <RadioButton GroupName="ScanMode"
                           IsChecked="{Binding IsQuickScan, Mode=TwoWay}"
                           Content="{DynamicResource L.QuickScan}" />
              <TextBlock Text="{DynamicResource L.QuickScanHint}"
                         Classes="caption"
                         FontSize="10.5"
                         Margin="24,0,0,0" />
              <RadioButton GroupName="ScanMode"
                           IsChecked="{Binding IsFullScan, Mode=TwoWay}"
                           Content="{DynamicResource L.FullScan}" />
              <TextBlock Text="{DynamicResource L.FullScanHint}"
                         Classes="caption"
                         FontSize="10.5"
                         Margin="24,0,0,0" />
            </StackPanel>

            <Border Height="1" Background="{DynamicResource BorderBrush}" />

            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="{DynamicResource L.Exclusions}" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource L.ExclusionsHint}"
                             Classes="caption"
                             FontSize="10.5"
                             TextWrapping="Wrap"
                             MaxWidth="480" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="ghost"
                        Content="{DynamicResource L.AddFolder}"
                        Click="OnAddFolder"
                        VerticalAlignment="Center" />
              </Grid>

              <ItemsControl ItemsSource="{Binding Exclusions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SettingsExclusionViewModel">
                    <Grid ColumnDefinitions="*,Auto" Height="26">
                      <TextBlock Text="{Binding Path}"
                                 FontSize="11"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="1"
                              Classes="mini"
                              Command="{Binding RemoveCommand}"
                              ToolTip.Tip="{DynamicResource L.RemoveExclusion}">
                        <Path Classes="icon small"
                              Data="M6 6 L18 18 M18 6 L6 18" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{DynamicResource L.NoExclusions}"
                         IsVisible="{Binding !HasExclusions}"
                         Classes="caption"
                         FontSize="10.5" />
            </StackPanel>

            <Border Height="1" Background="{DynamicResource BorderBrush}" />

            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource L.Thresholds}" FontSize="12" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="18" RowDefinitions="Auto,Auto,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="{DynamicResource L.LargeFileThreshold}" Classes="caption" FontSize="10.5" />
                  <NumericUpDown Value="{Binding LargeFileThresholdMb, Mode=TwoWay}"
                                 Minimum="1"
                                 Maximum="10240"
                                 Increment="10"
                                 FormatString="0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="{DynamicResource L.LargeFileLimit}" Classes="caption" FontSize="10.5" />
                  <NumericUpDown Value="{Binding LargeFileLimit, Mode=TwoWay}"
                                 Minimum="10"
                                 Maximum="2000"
                                 Increment="10"
                                 FormatString="0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="4" Margin="0,8,0,0">
                  <TextBlock Text="{DynamicResource L.DuplicateMinSize}" Classes="caption" FontSize="10.5" />
                  <NumericUpDown Value="{Binding DuplicateMinSizeMb, Mode=TwoWay}"
                                 Minimum="1"
                                 Maximum="1024"
                                 Increment="1"
                                 FormatString="0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4" Margin="0,8,0,0">
                  <TextBlock Text="{DynamicResource L.DuplicateGroupLimit}" Classes="caption" FontSize="10.5" />
                  <NumericUpDown Value="{Binding DuplicateGroupLimit, Mode=TwoWay}"
                                 Minimum="10"
                                 Maximum="2000"
                                 Increment="10"
                                 FormatString="0" />
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0">
                  <TextBlock Text="{DynamicResource L.HashBudget}" Classes="caption" FontSize="10.5" />
                  <NumericUpDown Value="{Binding HashBudgetGb, Mode=TwoWay}"
                                 Minimum="1"
                                 Maximum="64"
                                 Increment="1"
                                 FormatString="0" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="18,16" CornerRadius="14">
          <StackPanel Spacing="9">
            <TextBlock Text="{DynamicResource L.SectionBehaviour}" Classes="eyebrow" />
            <CheckBox IsChecked="{Binding UseAdminHelper, Mode=TwoWay}" Content="{DynamicResource L.UseAdminHelper}" />
            <CheckBox IsChecked="{Binding CheckForUpdatesOnStartup, Mode=TwoWay}" Content="{DynamicResource L.CheckUpdates}" />
            <CheckBox IsChecked="{Binding CloseToTray, Mode=TwoWay}" Content="{DynamicResource L.CloseToTray}" />
            <CheckBox IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Content="{DynamicResource L.MinimizeToTray}" />
            <CheckBox IsChecked="{Binding RunAtLogin, Mode=TwoWay}" Content="{DynamicResource L.RunAtLogin}" />
            <CheckBox IsChecked="{Binding ReminderEnabled, Mode=TwoWay}" Content="{DynamicResource L.ReminderEnabled}" />
            <Grid ColumnDefinitions="Auto,140" ColumnSpacing="10" Margin="24,0,0,0">
              <TextBlock Text="{DynamicResource L.ReminderInterval}"
                         Classes="caption"
                         FontSize="10.5"
                         VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="1"
                             Value="{Binding ReminderIntervalDays, Mode=TwoWay}"
                             Minimum="1"
                             Maximum="365"
                             Increment="1"
                             FormatString="0"
                             IsEnabled="{Binding ReminderEnabled}" />
            </Grid>
            <TextBlock Text="{DynamicResource L.ReminderHint}"
                       Classes="caption"
                       FontSize="10.5"
                       TextWrapping="Wrap"
                       MaxWidth="520" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1"
            Background="{DynamicResource ToolbarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   Classes="caption"
                   FontSize="10.5"
                   Foreground="{DynamicResource CautionBrush}"
                   TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto">
          <Button Classes="quiet"
                  Content="{DynamicResource L.Cancel}"
                  Click="OnCancel"
                  HorizontalAlignment="Left" />
          <Button Grid.Column="1"
                  Classes="primary"
                  Content="{DynamicResource L.Save}"
                  Click="OnSave" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
